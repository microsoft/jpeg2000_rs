diff --git a/core/fxcodec/jpx/jpx_decoder_unittest.cpp b/core/fxcodec/jpx/jpx_decoder_unittest.cpp
new file mode 100644
index 000000000..2fe95f54f
--- /dev/null
+++ b/core/fxcodec/jpx/jpx_decoder_unittest.cpp
@@ -0,0 +1,113 @@
+// Copyright 2026 The PDFium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "core/fxcodec/jpx/cjpx_decoder.h"
+
+#include <array>
+
+#include "core/fxcrt/span.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "testing/utils/file_util.h"
+#include "testing/utils/path_service.h"
+
+namespace fxcodec {
+namespace {
+
+TEST(JpxDecoderTest, DecodesRgbIntoPitchedBgrRows) {
+  const auto src =
+      GetFileContents(PathService::GetTestFilePath("RGB.jp2").c_str());
+  auto decoder = CJPX_Decoder::Create(
+      src, CJPX_Decoder::ColorSpaceOption::kNone, 0, /*strict_mode=*/true);
+  ASSERT_TRUE(decoder);
+  ASSERT_TRUE(decoder->StartDecode());
+  auto info = decoder->GetInfo();
+  ASSERT_EQ(info.width, 4u);
+  ASSERT_EQ(info.height, 4u);
+  ASSERT_EQ(info.channels, 3u);
+  EXPECT_EQ(info.colorspace, OPJ_CLRSPC_SRGB);
+
+  constexpr size_t kPitch = 16;
+  std::array<uint8_t, kPitch * 4> rgb = {};
+  std::array<uint8_t, kPitch * 4> bgr = {};
+  EXPECT_FALSE(decoder->Decode(rgb, 8, /*swap_rgb=*/false, 3));
+  ASSERT_TRUE(decoder->Decode(rgb, kPitch, /*swap_rgb=*/false, 3));
+  ASSERT_TRUE(decoder->Decode(bgr, kPitch, /*swap_rgb=*/true, 3));
+  EXPECT_NE(rgb, bgr);
+  for (size_t y = 0; y < 4; ++y) {
+    for (size_t x = 0; x < 12; x += 3) {
+      const size_t p = y * kPitch + x;
+      EXPECT_EQ(rgb[p], bgr[p + 2]);
+      EXPECT_EQ(rgb[p + 1], bgr[p + 1]);
+      EXPECT_EQ(rgb[p + 2], bgr[p]);
+    }
+    for (size_t x = 12; x < kPitch; ++x) {
+      EXPECT_EQ(bgr[y * kPitch + x], 0xff);
+    }
+  }
+}
+
+TEST(JpxDecoderTest, RejectsEmptyAndShortInput) {
+  const auto src =
+      GetFileContents(PathService::GetTestFilePath("RGB.jp2").c_str());
+  ASSERT_GT(src.size(), 12u);
+  for (size_t size = 0; size < 12; ++size) {
+    EXPECT_FALSE(CJPX_Decoder::Create(pdfium::span(src).first(size),
+                                      CJPX_Decoder::ColorSpaceOption::kNone, 0,
+                                      /*strict_mode=*/true));
+  }
+}
+
+TEST(JpxDecoderTest, RejectsTruncatedImageData) {
+  const auto src =
+      GetFileContents(PathService::GetTestFilePath("RGB.jp2").c_str());
+  ASSERT_GT(src.size(), 16u);
+  auto decoder = CJPX_Decoder::Create(pdfium::span(src).first(src.size() - 16),
+                                      CJPX_Decoder::ColorSpaceOption::kNone, 0,
+                                      /*strict_mode=*/true);
+  EXPECT_FALSE(decoder && decoder->StartDecode());
+}
+
+class JpxSyccDecoderTest : public testing::TestWithParam<const char*> {};
+
+TEST_P(JpxSyccDecoderTest, ConvertsToFullSizeRgb) {
+  SCOPED_TRACE(GetParam());
+  const auto src =
+      GetFileContents(PathService::GetTestFilePath(GetParam()).c_str());
+  auto decoder = CJPX_Decoder::Create(
+      src, CJPX_Decoder::ColorSpaceOption::kNone, 0, /*strict_mode=*/true);
+  ASSERT_TRUE(decoder);
+  ASSERT_TRUE(decoder->StartDecode());
+  const auto info = decoder->GetInfo();
+  ASSERT_EQ(info.width, 5u);
+  ASSERT_EQ(info.height, 3u);
+  ASSERT_EQ(info.channels, 3u);
+  EXPECT_EQ(info.colorspace, OPJ_CLRSPC_SRGB);
+
+  constexpr size_t kPitch = 16;
+  std::array<uint8_t, kPitch * 3> rgb = {};
+  ASSERT_TRUE(decoder->Decode(rgb, kPitch, /*swap_rgb=*/false, 3));
+  // Lossless fixtures use Y = 25 + 40*y + 25*x and alternate chroma
+  // samples (128, 128) and (144, 112) across each chroma row.
+  for (size_t y = 0; y < 3; ++y) {
+    for (size_t x : {0u, 4u}) {
+      const int luma = 25 + y * 40 + x * 25;
+      for (size_t c = 0; c < 3; ++c) {
+        EXPECT_NEAR(rgb[y * kPitch + 3 * x + c], luma, 1);
+      }
+    }
+    // Column 3 maps to a non-neutral sample in all three layouts.
+    const size_t p = y * kPitch + 3 * 3;
+    EXPECT_LT(rgb[p], rgb[p + 1]);
+    EXPECT_LT(rgb[p + 1], rgb[p + 2]);
+  }
+}
+
+INSTANTIATE_TEST_SUITE_P(SamplingLayouts,
+                         JpxSyccDecoderTest,
+                         testing::Values("jpx_sycc420.jp2",
+                                         "jpx_sycc422.jp2",
+                                         "jpx_sycc444.jp2"));
+
+}  // namespace
+}  // namespace fxcodec
