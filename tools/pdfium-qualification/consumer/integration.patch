new file mode 100644
index 000000000..ca2e698ce
--- /dev/null
+++ b/core/fxcodec/jpx/rust_jpx_decoder.cpp
@@ -0,0 +1,106 @@
+// Copyright 2026 The PDFium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "core/fxcodec/jpx/cjpx_decoder.h"
+
+#include <stdio.h>
+
+#include <string>
+#include <utility>
+
+#include "core/fxcodec/jpx/rust_jpx_ffi.rs.h"
+#include "core/fxcrt/ptr_util.h"
+
+namespace fxcodec {
+
+namespace {
+
+void LogDecodeFailure(const char* stage, rust::Str error) {
+#if !defined(NDEBUG)
+  fprintf(stderr, "Rust JPX %s failed: %s\n", stage,
+          std::string(error).c_str());
+#endif
+}
+
+}  // namespace
+
+struct CJPX_Decoder::RustState {
+  rust::Box<rust_jpx::Decoder> decoder;
+  pdfium::raw_span<const uint8_t> source;
+  uint8_t discard_levels;
+  bool indexed;
+  bool strict;
+};
+
+CJPX_Decoder::CJPX_Decoder(std::unique_ptr<RustState> state)
+    : rust_state_(std::move(state)) {}
+
+CJPX_Decoder::~CJPX_Decoder() = default;
+
+std::unique_ptr<CJPX_Decoder> CJPX_Decoder::Create(
+    pdfium::span<const uint8_t> source,
+    ColorSpaceOption option,
+    uint8_t discard_levels,
+    bool strict) {
+  if (discard_levels > kMaxResolutionsToSkip) {
+    return nullptr;
+  }
+  auto decoder = rust_jpx::create();
+  if (!decoder->inspect({source.data(), source.size()}, strict)) {
+#if defined(PDF_ENABLE_RUST_JPEG2000_PDF_RECOVERY)
+    if (!strict || option == ColorSpaceOption::kIndexed ||
+        !decoder->inspect({source.data(), source.size()}, false)) {
+      LogDecodeFailure("inspection", decoder->error());
+      return nullptr;
+    }
+    strict = false;
+#else
+    LogDecodeFailure("inspection", decoder->error());
+    return nullptr;
+#endif
+  }
+  return pdfium::WrapUnique(new CJPX_Decoder(std::make_unique<RustState>(
+      RustState{std::move(decoder), source, discard_levels,
+                option == ColorSpaceOption::kIndexed, strict})));
+}
+
+CJPX_Decoder::JpxImageInfo CJPX_Decoder::GetInfo() const {
+  const auto info = rust_state_->decoder->info();
+  COLOR_SPACE colorspace = OPJ_CLRSPC_UNKNOWN;
+  switch (info.colorspace) {
+    case rust_jpx::ColorSpace::Unknown:
+      break;
+    case rust_jpx::ColorSpace::Gray:
+      colorspace = OPJ_CLRSPC_GRAY;
+      break;
+    case rust_jpx::ColorSpace::Rgb:
+      colorspace = OPJ_CLRSPC_SRGB;
+      break;
+    case rust_jpx::ColorSpace::Cmyk:
+      colorspace = OPJ_CLRSPC_CMYK;
+      break;
+  }
+  return {info.width, info.height, info.channels, colorspace};
+}
+
+bool CJPX_Decoder::StartDecode() {
+  const auto source = rust_state_->source;
+  if (!rust_state_->decoder->decode(
+          {source.data(), source.size()}, rust_state_->discard_levels,
+          rust_state_->indexed, rust_state_->strict)) {
+    LogDecodeFailure("decoding", rust_state_->decoder->error());
+    return false;
+  }
+  return true;
+}
+
+bool CJPX_Decoder::Decode(pdfium::span<uint8_t> dest,
+                          uint32_t pitch,
+                          bool swap_rgb,
+                          uint32_t components) {
+  return rust_state_->decoder->write_pixels({dest.data(), dest.size()}, pitch,
+                                           swap_rgb, components);
+}
+
+}  // namespace fxcodec
diff --git a/core/fxcodec/jpx/rust_jpx_ffi.rs b/core/fxcodec/jpx/rust_jpx_ffi.rs
new file mode 100644
index 000000000..9032ec5af
--- /dev/null
+++ b/core/fxcodec/jpx/rust_jpx_ffi.rs
@@ -0,0 +1,285 @@
+// Copyright 2026 The PDFium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+use jpeg2000_decoder::jp2::{self, BoxType, ColorMethod};
+use jpeg2000_decoder::{
+    codestream, convert_jp2_color, decode_codestream_selected, decode_jp2_selected,
+    decode_jph_selected, decode_jpx_codestream_selected, decode_pdf_compatible, DecodeOptions,
+    DecodeSelection, TypedImage, TypedSamples,
+};
+
+#[cxx::bridge(namespace = "fxcodec::rust_jpx")]
+mod ffi {
+    enum ColorSpace {
+        Unknown,
+        Gray,
+        Rgb,
+        Cmyk,
+    }
+
+    struct ImageInfo {
+        width: u32,
+        height: u32,
+        channels: u32,
+        colorspace: ColorSpace,
+    }
+
+    extern "Rust" {
+        type Decoder;
+        fn create() -> Box<Decoder>;
+        fn inspect(self: &mut Decoder, src: &[u8], strict: bool) -> bool;
+        fn decode(self: &mut Decoder, src: &[u8], discard: u8, indexed: bool, strict: bool)
+            -> bool;
+        fn info(self: &Decoder) -> ImageInfo;
+        fn error(self: &Decoder) -> &str;
+        fn write_pixels(
+            self: &Decoder,
+            dest: &mut [u8],
+            pitch: usize,
+            swap_rgb: bool,
+            components: usize,
+        ) -> bool;
+    }
+}
+
+use ffi::{ColorSpace, ImageInfo};
+
+struct Decoder {
+    info: ImageInfo,
+    pixels: Vec<u8>,
+    error: String,
+}
+
+fn create() -> Box<Decoder> {
+    Box::new(Decoder {
+        info: ImageInfo { width: 0, height: 0, channels: 0, colorspace: ColorSpace::Unknown },
+        pixels: Vec::new(),
+        error: String::new(),
+    })
+}
+
+fn is_boxed(src: &[u8]) -> bool {
+    src.starts_with(b"\x00\x00\x00\x0cjP  \x0d\x0a\x87\x0a")
+}
+
+fn sample_to_byte(value: i128, precision: u8, signed: bool) -> u8 {
+    let value = if signed { value + (1i128 << (precision - 1)) } else { value };
+    let rounded = if precision <= 8 {
+        value << (8 - precision)
+    } else {
+        (value + (1i128 << (precision - 9))) >> (precision - 8)
+    };
+    rounded.clamp(0, 255) as u8
+}
+
+fn allocate_pixels(width: u32, height: u32, count: usize) -> Result<(usize, Vec<u8>), String> {
+    let area = (width as usize).checked_mul(height as usize).ok_or("JPX image size overflow")?;
+    let size = area.checked_mul(count).ok_or("JPX output size overflow")?;
+    let mut pixels = Vec::new();
+    pixels.try_reserve_exact(size).map_err(|e| e.to_string())?;
+    Ok((area, pixels))
+}
+
+fn pack(image: &TypedImage) -> Result<Vec<u8>, String> {
+    let (area, mut pixels) =
+        allocate_pixels(image.width(), image.height(), image.components().len())?;
+    for channel in image.components() {
+        let info = channel.info();
+        if channel.width() != image.width()
+            || channel.height() != image.height()
+            || !(1..=64).contains(&info.precision)
+        {
+            return Err("unsupported JPX component geometry or precision".into());
+        }
+        match channel.samples() {
+            TypedSamples::Signed(values) if values.len() == area => pixels
+                .extend(values.iter().map(|&v| sample_to_byte(v.into(), info.precision, true))),
+            TypedSamples::Unsigned(values) if values.len() == area => pixels
+                .extend(values.iter().map(|&v| sample_to_byte(v.into(), info.precision, false))),
+            _ => return Err("unexpected JPX component sample count".into()),
+        }
+    }
+    Ok(pixels)
+}
+
+impl Decoder {
+    fn info(&self) -> ImageInfo {
+        ImageInfo { ..self.info }
+    }
+
+    fn error(&self) -> &str {
+        &self.error
+    }
+
+    fn inspect(&mut self, src: &[u8], strict: bool) -> bool {
+        let options = DecodeOptions::default();
+        let result = if !strict {
+            jpeg2000_decoder::inspect_pdf_compatible(src, &options)
+        } else if is_boxed(src) {
+            jp2::parse(src, options.limits())
+                .and_then(|file| codestream::parse(file.codestream(0)?.data(), options.limits()))
+        } else {
+            codestream::parse(src, options.limits())
+        };
+        match result {
+            Ok(info) => {
+                let size = info.image_size;
+                self.info.width = size.width;
+                self.info.height = size.height;
+                self.info.channels = size.components.into();
+                true
+            }
+            Err(error) => {
+                self.error = format!("{error:?}");
+                false
+            }
+        }
+    }
+
+    fn decode(&mut self, src: &[u8], discard: u8, indexed: bool, strict: bool) -> bool {
+        match decode_image(src, discard, indexed, strict) {
+            Ok((info, pixels)) => {
+                self.info = info;
+                self.pixels = pixels;
+                true
+            }
+            Err(error) => {
+                self.error = error;
+                false
+            }
+        }
+    }
+
+    fn write_pixels(
+        &self,
+        dest: &mut [u8],
+        pitch: usize,
+        swap_rgb: bool,
+        components: usize,
+    ) -> bool {
+        let channels = self.info.channels as usize;
+        let count = if components == 3 && channels == 4 { 4 } else { components };
+        let (width, height) = (self.info.width as usize, self.info.height as usize);
+        let (Some(row_bytes), Some(area), Some(output_size)) =
+            (width.checked_mul(count), width.checked_mul(height), pitch.checked_mul(height))
+        else {
+            return false;
+        };
+        if count == 0
+            || count > channels
+            || (swap_rgb && count < 3)
+            || row_bytes > pitch
+            || output_size > dest.len()
+            || area == 0
+            || area.checked_mul(channels) != Some(self.pixels.len())
+        {
+            return false;
+        }
+        let dest = &mut dest[..output_size];
+        dest.fill(0xff);
+        for (y, row) in dest.chunks_exact_mut(pitch).enumerate() {
+            for (x, pixel) in row[..row_bytes].chunks_exact_mut(count).enumerate() {
+                for (i, dst) in pixel.iter_mut().enumerate() {
+                    let channel = if swap_rgb && (i == 0 || i == 2) { 2 - i } else { i };
+                    *dst = self.pixels[channel * area + y * width + x];
+                }
+            }
+        }
+        true
+    }
+}
+
+fn decode_image(
+    src: &[u8],
+    discard: u8,
+    indexed: bool,
+    strict: bool,
+) -> Result<(ImageInfo, Vec<u8>), String> {
+    let options = DecodeOptions::default();
+    let selection = DecodeSelection::default().with_discard_levels(discard);
+    let error = |e| format!("{e:?}");
+    let recovered = if !strict && !indexed {
+        Some(decode_pdf_compatible(src, &options, &selection).map_err(error)?)
+    } else {
+        None
+    };
+    let discarded_eol =
+        recovered.as_ref().map_or(0, |result| result.recovery.discarded_pdf_eol_bytes);
+    let metadata_end =
+        src.len().checked_sub(discarded_eol.into()).ok_or("invalid recovery length")?;
+    let container = if is_boxed(src) {
+        Some(jp2::parse(&src[..metadata_end], options.limits()).map_err(error)?)
+    } else {
+        None
+    };
+    let mut colorspace = ColorSpace::Unknown;
+    let image = if let Some(result) = recovered {
+        Ok(result.image)
+    } else if let Some(file) = &container {
+        if file.codestream_count() != 1 {
+            return Err("PDF JPXDecode requires one codestream".into());
+        }
+        if indexed {
+            decode_codestream_selected(
+                file.codestream(0).map_err(error)?.data(),
+                &options,
+                &selection,
+            )
+        } else if file.file_type.brand == BoxType::JPH_BRAND {
+            decode_jph_selected(src, &options, &selection)
+        } else if file.file_type.brand == BoxType::JPX_BRAND {
+            decode_jpx_codestream_selected(src, 0, &options, &selection)
+        } else {
+            decode_jp2_selected(src, &options, &selection)
+        }
+    } else {
+        decode_codestream_selected(src, &options, &selection)
+    }
+    .map_err(error)?;
+
+    if let Some(file) = container.as_ref().filter(|_| !indexed) {
+        match file.header.color.method {
+            ColorMethod::Enumerated { color_space: 16 } => colorspace = ColorSpace::Rgb,
+            ColorMethod::Enumerated { color_space: 17 } => colorspace = ColorSpace::Gray,
+            ColorMethod::Enumerated { color_space: 12 } => colorspace = ColorSpace::Cmyk,
+            ColorMethod::Enumerated { color_space: 18 } => {
+                let rgb = convert_jp2_color(&image, &file.header.color, options.limits())
+                    .map_err(error)?;
+                let (area, mut pixels) =
+                    allocate_pixels(rgb.width(), rgb.height(), rgb.channels().len())?;
+                for channel in rgb.channels() {
+                    if channel.samples().len() != area {
+                        return Err("unexpected JPX converted sample count".into());
+                    }
+                    pixels.extend(
+                        channel
+                            .samples()
+                            .iter()
+                            .map(|&v| sample_to_byte(v.into(), rgb.precision(), false)),
+                    );
+                }
+                return Ok((
+                    ImageInfo {
+                        width: rgb.width(),
+                        height: rgb.height(),
+                        channels: rgb.channels().len() as u32,
+                        colorspace: ColorSpace::Rgb,
+                    },
+                    pixels,
+                ));
+            }
+            _ => {}
+        }
+    }
+    if image.components().len() <= 2 {
+        colorspace = ColorSpace::Gray;
+    }
+    let info = ImageInfo {
+        width: image.width(),
+        height: image.height(),
+        channels: image.components().len() as u32,
+        colorspace,
+    };
+    Ok((info, pack(&image)?))
+}
diff --git a/jp2_eval.cpp b/jp2_eval.cpp
new file mode 100644
index 000000000..18a8e62ec
--- /dev/null
+++ b/jp2_eval.cpp
@@ -0,0 +1,171 @@
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+#include "core/fxcodec/jpx/cjpx_decoder.h"
+#include "public/fpdfview.h"
+
+namespace {
+
+struct Result {
+  std::string status;
+  uint32_t width = 0;
+  uint32_t height = 0;
+  uint32_t channels = 0;
+  int color = 0;
+  std::vector<uint8_t> pixels;
+};
+
+Result Image(const std::vector<uint8_t>& input,
+             bool strict,
+             uint8_t reduce,
+             bool indexed) {
+  auto decoder = CJPX_Decoder::Create(
+      input, indexed ? CJPX_Decoder::ColorSpaceOption::kIndexed
+                     : CJPX_Decoder::ColorSpaceOption::kNormal,
+      reduce, strict);
+  if (!decoder) {
+    return {"header_error"};
+  }
+  if (!decoder->StartDecode()) {
+    return {"decode_error"};
+  }
+  auto info = decoder->GetInfo();
+  Result result{"output_limit", info.width, info.height, info.channels,
+                static_cast<int>(info.colorspace)};
+  uint64_t row = static_cast<uint64_t>(info.width) * info.channels;
+  uint64_t pitch = (row + 3) & ~uint64_t{3};
+  if (!info.width || !info.height || !info.channels || info.channels > 16 ||
+      pitch > UINT32_MAX || pitch * info.height > 512 * 1024 * 1024) {
+    return result;
+  }
+  std::vector<uint8_t> padded(pitch * info.height);
+  if (!decoder->Decode(padded, static_cast<uint32_t>(pitch), false,
+                       info.channels)) {
+    result.status = "pack_error";
+    return result;
+  }
+  result.pixels.reserve(row * info.height);
+  for (uint32_t y = 0; y < info.height; ++y) {
+    auto begin = padded.begin() + y * pitch;
+    result.pixels.insert(result.pixels.end(), begin, begin + row);
+  }
+  result.status = "ok";
+  return result;
+}
+
+Result Pdf(const std::vector<uint8_t>& input) {
+  FPDF_DOCUMENT doc = FPDF_LoadMemDocument64(input.data(), input.size(), nullptr);
+  if (!doc) {
+    return {"document_error"};
+  }
+  Result result{"ok"};
+  int count = FPDF_GetPageCount(doc);
+  for (int i = 0; i < count; ++i) {
+    FPDF_PAGE page = FPDF_LoadPage(doc, i);
+    if (!page) {
+      result.status = "page_error";
+      break;
+    }
+    int w = static_cast<int>(FPDF_GetPageWidthF(page) + 0.5f);
+    int h = static_cast<int>(FPDF_GetPageHeightF(page) + 0.5f);
+    if (w <= 0 || h <= 0 || static_cast<uint64_t>(w) * h > 32000000) {
+      FPDF_ClosePage(page);
+      result.status = "output_limit";
+      break;
+    }
+    FPDF_BITMAP bitmap = FPDFBitmap_Create(w, h, 1);
+    if (!bitmap) {
+      FPDF_ClosePage(page);
+      result.status = "bitmap_error";
+      break;
+    }
+    FPDFBitmap_FillRect(bitmap, 0, 0, w, h, 0xffffffff);
+    FPDF_RenderPageBitmap(bitmap, page, 0, 0, w, h, 0, FPDF_ANNOT);
+    auto* data = static_cast<uint8_t*>(FPDFBitmap_GetBuffer(bitmap));
+    int stride = FPDFBitmap_GetStride(bitmap);
+    for (int y = 0; y < h; ++y) {
+      result.pixels.insert(result.pixels.end(), data + y * stride,
+                           data + y * stride + w * 4);
+    }
+    result.width = static_cast<uint32_t>(w);
+    result.height += static_cast<uint32_t>(h);
+    result.channels = 4;
+    result.color = count;
+    FPDFBitmap_Destroy(bitmap);
+    FPDF_ClosePage(page);
+  }
+  FPDF_CloseDocument(doc);
+  return result;
+}
+
+}  // namespace
+
+int main(int argc, char** argv) {
+  if (argc != 8) {
+    std::fprintf(stderr, "mode input output strict reduce indexed repetitions\n");
+    return 2;
+  }
+  std::ifstream file(argv[2], std::ios::binary);
+  if (!file) {
+    std::perror(argv[2]);
+    return 2;
+  }
+  std::vector<uint8_t> input((std::istreambuf_iterator<char>(file)), {});
+  bool pdf = std::string(argv[1]) == "pdf";
+  if (pdf) {
+    FPDF_LIBRARY_CONFIG config{};
+    config.version = 2;
+    FPDF_InitLibraryWithConfig(&config);
+  }
+  bool strict = std::atoi(argv[4]) != 0;
+  uint8_t reduce = static_cast<uint8_t>(std::atoi(argv[5]));
+  bool indexed = std::atoi(argv[6]) != 0;
+  int runs = std::atoi(argv[7]);
+  auto decode = [&]() {
+    return pdf ? Pdf(input) : Image(input, strict, reduce, indexed);
+  };
+  Result result = decode();
+  std::vector<double> times;
+  if (result.status == "ok") {
+    std::ofstream output(argv[3], std::ios::binary);
+    output.write(reinterpret_cast<const char*>(result.pixels.data()),
+                 result.pixels.size());
+    if (!output) {
+      std::fprintf(stderr, "Cannot write pixels\n");
+      return 2;
+    }
+    for (int i = 0; runs && i < 3; ++i) {
+      if (decode().status != "ok") {
+        std::fprintf(stderr, "Warmup failed\n");
+        return 2;
+      }
+    }
+    for (int i = 0; i < runs; ++i) {
+      auto start = std::chrono::steady_clock::now();
+      auto repeated = decode();
+      double us = std::chrono::duration<double, std::micro>(
+                      std::chrono::steady_clock::now() - start).count();
+      if (repeated.status != "ok" || repeated.pixels != result.pixels) {
+        std::fprintf(stderr, "Non-repeatable decode\n");
+        return 2;
+      }
+      times.push_back(us);
+    }
+  }
+  std::sort(times.begin(), times.end());
+  double p50 = times.empty() ? 0 : times[times.size() / 2];
+  double p90 = times.empty() ? 0 : times[times.size() * 9 / 10];
+  std::printf("%s\t%u\t%u\t%u\t%d\t%.3f\t%.3f\t%zu\n",
+              result.status.c_str(), result.width, result.height,
+              result.channels, result.color, p50, p90, times.size());
+  if (pdf) {
+    FPDF_DestroyLibrary();
+  }
+  return 0;
+}
